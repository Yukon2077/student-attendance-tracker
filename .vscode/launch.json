{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: Flask",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "env": {
        "FLASK_APP": "Flask\\student_attendance_tracker\\__init__.py",
        "FLASK_DEBUG": "1",
        "FLASK_ENV": "dev",
        "FLASK_RUN_HOST": "0.0.0.0",
        "FLASK_RUN_PORT": "8080"
      },
      "args": ["run", "--no-debugger", "--no-reload"],
      "jinja": true,
      "autoStartBrowser": false
    }
  ]
}
